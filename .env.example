# Application
APP_ENV=development
LOG_LEVEL=INFO
WORKER_CONCURRENCY=3
JOB_TARGET_SECONDS=180
JOB_MAX_ATTEMPTS=3
PIPELINE_VERSION=v1

# Local PostgreSQL: host access defaults to 127.0.0.1 only
POSTGRES_HOST_PORT=127.0.0.1:5433:5432

# PostgreSQL (internal Docker Compose hostname)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=transcript
POSTGRES_USER=transcript
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD

# External Kafka: obtain real address + security settings from Sprintly
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CONSUMER_GROUP=transcript-service
KAFKA_INPUT_TOPIC=material.events
KAFKA_OUTPUT_TOPIC=transcript.events
KAFKA_INPUT_DLQ_TOPIC=material.events.dlq
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# External S3-compatible storage; provider is not known yet
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_OUTPUT_BUCKET=
S3_ADDRESSING_STYLE=auto

# DeepSeek: for summaries + vision OCR
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Groq: speech to text
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo

# Resource limits (initial project values; verify in tests)
MAX_DOCUMENT_FILE_SIZE_MB=50
MAX_PDF_PAGES=500
MAX_MEDIA_DURATION_SECONDS=3600
MAX_MEDIA_FILE_SIZE_MB=200
API_REQUEST_TIMEOUT_SECONDS=120
