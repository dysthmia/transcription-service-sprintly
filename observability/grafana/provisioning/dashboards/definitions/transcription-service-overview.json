{
  "uid": "transcription-service-overview",
  "title": "Transcription Service Overview",
  "tags": ["observability", "loki", "transcription-service"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "service", "label": "Service", "type": "query", "datasource": {"type": "loki", "uid": "loki"}, "query": "label_values({service=~\".+\"}, service)", "definition": "label_values({service=~\".+\"}, service)", "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "transcription-service", "value": "transcription-service"}},
      {"name": "environment", "label": "Environment", "type": "query", "datasource": {"type": "loki", "uid": "loki"}, "query": "label_values({service=~\"$service\"}, environment)", "definition": "label_values({service=~\"$service\"}, environment)", "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": "$__all"}},
      {"name": "component", "label": "Component", "type": "query", "datasource": {"type": "loki", "uid": "loki"}, "query": "label_values({service=~\"$service\"}, component)", "definition": "label_values({service=~\"$service\"}, component)", "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": "$__all"}},
      {"name": "level", "label": "Level", "type": "query", "datasource": {"type": "loki", "uid": "loki"}, "query": "label_values({service=~\"$service\"}, level)", "definition": "label_values({service=~\"$service\"}, level)", "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": "$__all"}},
      {"name": "event", "label": "Event regex", "type": "textbox", "query": ".*", "current": {"text": ".*", "value": ".*"}},
      {"name": "job_id", "label": "Job ID regex", "type": "textbox", "query": ".*", "current": {"text": ".*", "value": ".*"}},
      {"name": "correlation_id", "label": "Correlation ID regex", "type": "textbox", "query": ".*", "current": {"text": ".*", "value": ".*"}}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Job registrations", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum(count_over_time({service=~\"$service\",environment=~\"$environment\"} | json | event=\"job.registered\" [$__range]))", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto"}, "gridPos": {"h": 6, "w": 4, "x": 0, "y": 0}},
    {"id": 2, "type": "stat", "title": "Job completed", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum(count_over_time({service=~\"$service\",environment=~\"$environment\"} | json | event=\"job.completed\" [$__range]))", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "green"}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "gridPos": {"h": 6, "w": 4, "x": 4, "y": 0}},
    {"id": 3, "type": "stat", "title": "Job failed", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum(count_over_time({service=~\"$service\",environment=~\"$environment\"} | json | event=\"job.failed\" [$__range]))", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "gridPos": {"h": 6, "w": 4, "x": 8, "y": 0}},
    {"id": 4, "type": "stat", "title": "Success rate", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "100 * sum(count_over_time({service=~\"$service\",environment=~\"$environment\"} | json | event=\"job.completed\" [$__range])) / (sum(count_over_time({service=~\"$service\",environment=~\"$environment\"} | json | event=\"job.completed\" [$__range])) + sum(count_over_time({service=~\"$service\",environment=~\"$environment\"} | json | event=\"job.failed\" [$__range])))", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 95}, {"color": "green", "value": 99}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "gridPos": {"h": 6, "w": 4, "x": 12, "y": 0}},
    {"id": 5, "type": "stat", "title": "Retries scheduled", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum(count_over_time({service=~\"$service\",environment=~\"$environment\"} | json | event=\"job.retry.scheduled\" [$__range]))", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "gridPos": {"h": 6, "w": 4, "x": 16, "y": 0}},
    {"id": 6, "type": "stat", "title": "DLQ messages", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum(count_over_time({service=~\"$service\",environment=~\"$environment\"} | json | event=\"kafka.message.sent_to_dlq\" [$__range]))", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "gridPos": {"h": 6, "w": 4, "x": 20, "y": 0}},
    {"id": 7, "type": "timeseries", "title": "Failures by error code", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum by (error_code) (count_over_time({service=~\"$service\",environment=~\"$environment\"} | json | event=\"job.failed\" [$__interval]))", "legendFormat": "{{error_code}}", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}},
    {"id": 8, "type": "timeseries", "title": "Failures by stage", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum by (stage) (count_over_time({service=~\"$service\",environment=~\"$environment\"} | json | event=\"job.failed\" [$__interval]))", "legendFormat": "{{stage}}", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}},
    {"id": 9, "type": "timeseries", "title": "Job duration p50 / p95", "description": "Terminal job.completed duration_ms is measured by the worker with perf_counter.", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "quantile_over_time(0.50, {service=~\"$service\",environment=~\"$environment\"} | json | event=\"job.completed\" | unwrap duration_ms [$__interval])", "legendFormat": "p50", "queryType": "range"}, {"refId": "B", "expr": "quantile_over_time(0.95, {service=~\"$service\",environment=~\"$environment\"} | json | event=\"job.completed\" | unwrap duration_ms [$__interval])", "legendFormat": "p95", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}},
    {"id": 10, "type": "timeseries", "title": "Stage duration p50 / p95", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "quantile_over_time(0.50, {service=~\"$service\",environment=~\"$environment\"} | json | event=\"job.stage.completed\" | unwrap duration_ms [$__interval]) by (stage)", "legendFormat": "p50 {{stage}}", "queryType": "range"}, {"refId": "B", "expr": "quantile_over_time(0.95, {service=~\"$service\",environment=~\"$environment\"} | json | event=\"job.stage.completed\" | unwrap duration_ms [$__interval]) by (stage)", "legendFormat": "p95 {{stage}}", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}},
    {"id": 11, "type": "timeseries", "title": "External request latency", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "quantile_over_time(0.95, {service=~\"$service\",environment=~\"$environment\"} | json | event=\"external_request.completed\" | provider=~\"deepseek|groq|s3\" | unwrap duration_ms [$__interval]) by (provider)", "legendFormat": "p95 {{provider}}", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22}},
    {"id": 12, "type": "timeseries", "title": "External dependency errors by provider", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum by (provider) (count_over_time({service=~\"$service\",environment=~\"$environment\"} | json | event=\"external_request.failed\" [$__interval]))", "legendFormat": "{{provider}}", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22}},
    {"id": 13, "type": "timeseries", "title": "Outbox publish retries", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum(count_over_time({service=~\"$service\",environment=~\"$environment\"} | json | event=\"outbox.retry.scheduled\" [$__interval]))", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30}},
    {"id": 14, "type": "timeseries", "title": "Background task failures", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "sum(count_over_time({service=~\"$service\",environment=~\"$environment\"} | json | event=\"background_task.failed\" [$__interval]))", "queryType": "range"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30}},
    {"id": 15, "type": "table", "title": "Latest ERROR / WARNING", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "{service=~\"$service\",environment=~\"$environment\",level=~\"warning|error\"} | json", "queryType": "range", "limit": 100, "direction": "backward"}], "transformations": [], "options": {"showHeader": true}, "gridPos": {"h": 10, "w": 24, "x": 0, "y": 38}},
    {"id": 16, "type": "logs", "title": "Structured logs", "datasource": {"type": "loki", "uid": "loki"}, "targets": [{"refId": "A", "expr": "{service=~\"$service\",environment=~\"$environment\",component=~\"$component\",level=~\"$level\"} | json | event=~\"$event\" | job_id=~\"$job_id\" | correlation_id=~\"$correlation_id\"", "queryType": "range", "limit": 1000, "direction": "backward"}], "options": {"dedupStrategy": "none", "enableLogDetails": true, "showCommonLabels": false, "showLabels": false, "sortOrder": "Descending", "wrapLogMessage": true}, "gridPos": {"h": 12, "w": 24, "x": 0, "y": 48}}
  ]
}
